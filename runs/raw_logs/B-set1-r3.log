20renderer.updateClasses%28access_layer%2C%205%29%0A%20%20%20%20color_start%20%3D%20QColor%28173%2C%20216%2C%20230%29%20%20%23%20light%20blue%0A%20%20%20%20color_end%20%3D%20QColor%280%2C%200%2C%20139%29%20%20%20%20%20%20%20%20%23%20dark%20blue%0A%20%20%20%20color_ramp%20%3D%20QgsGradientColorRamp%28color_start%2C%20color_end%29%0A%20%20%20%20renderer.updateColorRamp%28color_ramp%29%0A%20%20%20%20access_layer.setRenderer%28renderer%29%0A%20%20%20%20access_layer.triggerRepaint%28%29%0A%0A%20%20%20%20%23%20----------------------------------------------------------------------%0A%20%20%20%20%23%205.%20Create%20scatter%20plot%20of%20OBESITY%20vs%20ACCESS_SCORE%0A%20%20%20%20%23%20----------------------------------------------------------------------%0A%20%20%20%20scatter_output%20%3D%20unique_path%28output_dir%2C%20%22obesity_access_scatter%22%2C%20%22.html%22%29%0A%20%20%20%20scatter_params%20%3D%20%7B%0A%20%20%20%20%20%20%20%20%22INPUT%22%3A%20calc_output%2C%0A%20%20%20%20%20%20%20%20%22XFIELD%22%3A%20%22ACCESS_SCORE%22%2C%0A%20%20%20%20%20%20%20%20%22YFIELD%22%3A%20%22OBESITY%22%2C%0A%20%20%20%20%20%20%20%20%22OUTPUT%22%3A%20scatter_output%2C%0A%20%20%20%20%7D%0A%20%20%20%20scatter_result%20%3D%20processing.run%28%22qgis%3Avectorlayerscatterplot%22%2C%20scatter_params%29%0A%20%20%20%20print%28scatter_result%5B%22OUTPUT%22%5D%29%0A%0A%20%20%20%20%23%20----------------------------------------------------------------------%0A%20%20%20%20%23%206.%20Regression%20analysis%0A%20%20%20%20%23%20----------------------------------------------------------------------%0A%20%20%20%20access_scores%20%3D%20%5B%5D%0A%20%20%20%20obesity_rates%20%3D%20%5B%5D%0A%20%20%20%20for%20feat%20in%20access_layer.getFeatures%28%29%3A%0A%20%20%20%20%20%20%20%20access_scores.append%28feat%5B%22ACCESS_SCORE%22%5D%29%0A%20%20%20%20%20%20%20%20obesity_rates.append%28feat%5B%22OBESITY%22%5D%29%0A%20%20%20%20slope%2C%20intercept%2C%20r_value%2C%20p_value%2C%20std_err%20%3D%20linregress%28%0A%20%20%20%20