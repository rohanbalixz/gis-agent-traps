ies_layer%2C%205%29%0A%20%20%20%20%23%20Define%20color%20ramp%20from%20light%20blue%20to%20dark%20blue%0A%20%20%20%20color_start%20%3D%20QColor%28173%2C%20216%2C%20230%29%20%20%23%20light%20blue%0A%20%20%20%20color_end%20%3D%20QColor%280%2C%200%2C%20139%29%20%20%20%20%20%20%20%20%23%20dark%20blue%0A%20%20%20%20ramp%20%3D%20QgsGradientColorRamp%28color_start%2C%20color_end%29%0A%20%20%20%20renderer.updateColorRamp%28ramp%29%0A%20%20%20%20cities_layer.setRenderer%28renderer%29%0A%20%20%20%20cities_layer.triggerRepaint%28%29%0A%0A%20%20%20%20%23%20----%204.%20Correlation%20Analysis%20----%0A%20%20%20%20covariates%20%3D%20%5B%27GROWTH%27%2C%20%27NDVI%27%2C%20%27POP_DENS%27%5D%0A%20%20%20%20print%28%22%5CnPearson%20Correlation%20%28Entire%20Dataset%29%3A%22%29%0A%20%20%20%20for%20cov%20in%20covariates%3A%0A%20%20%20%20%20%20%20%20r%2C%20p%20%3D%20pearsonr%28gdf%5Bcov%5D%2C%20gdf%5B%27ERROR%27%5D%29%0A%20%20%20%20%20%20%20%20print%28f%22%20%20%7Bcov%7D%20vs%20ERROR%3A%20r%3D%7Br%3A.3f%7D%2C%20p%3D%7Bp%3A.3e%7D%22%29%0A%0A%20%20%20%20print%28%22%5CnPearson%20Correlation%20%28Region%20B%29%3A%22%29%0A%20%20%20%20df_b%20%3D%20gdf%5Bgdf%5B%27REGION%27%5D%20%3D%3D%20%27B%27%5D%0A%20%20%20%20for%20cov%20in%20covariates%3A%0A%20%20%20%20%20%20%20%20r%2C%20p%20%3D%20pearsonr%28df_b%5Bcov%5D%2C%20df_b%5B%27ERROR%27%5D%29%0A%20%20%20%20%20%20%20%20print%28f%22%20%20%7Bcov%7D%20vs%20ERROR%3A%20r%3D%7Br%3A.3f%7D%2C%20p%3D%7Bp%3A.3e%7D%22%29%0A%0A%20%20%20%20%23%20----%205.%20Identify%20Dominant%20Covariate%20in%20Region%20B%20----%0A%20%20%20%20corr_b%20%3D%20%7B%7D%0A%20%20%20%20for%20cov%20in%20covariates%3A%0A%20%20%20%20%20%20%20%20r%2C%20_%20%3D%20pearsonr%28df_b%5Bcov%5D%2C%20df_b%5B%27ERROR%27%5D%29%0A%20%20%20%20%20%20%20%20corr_b%5Bcov%5D%20%3D%20abs%28r%29%0A%20%20%20%20dominant%20%3D%20max%28corr_b%2C%20key%3Dcorr_b.get%29%0A%20%20%20%20print%28f%22%5CnDominant%20covariate%20driving%20higher%20ERROR%20in%20Region%20B%3A%20%7Bdominant%7D%22%29%0A%0A%20%20%20%20%23%20Add%20a