# Spatial Error Analysis for Cities Layer
#===================================================================================================================
# This function performs:
#   1. Attribute selection of Region A and Region B cities.
#   2. Basic statistics for ERROR, GROWTH, NDVI, POP_DENS for each subset.
#   3. Linear regression of ERROR on GROWTH, NDVI, POP_DENS using statsmodels.
#   4. Thematic point map of ERROR for all cities (regional differences highlighted).
#   5. Outputs are saved in the specified workspace directory.
#===================================================================================================================

import os
import processing
from qgis.core import (
    QgsVectorLayer,
    QgsProject,
    QgsSymbol,
    QgsGraduatedSymbolRenderer,
    QgsGradientColorRamp,
    QgsFeatureRequest,
    QgsSpatialIndex
)

def unique_output_path(output_dir, base_name, ext):
    """
    Create a unique file path within output_dir.
    If base_name.ext exists, append a number before the extension.
    """
    counter = 1
    name = f"{base_name}{ext}"
    path = os.path.join(output_dir, name)
    while os.path.exists(path):
        name = f"{base_name}_{counter}{ext}"
        path = os.path.join(output_dir, name)
        counter += 1
    return path

def perform_spatial_error_analysis():
    # -----------------------------
    # Input and output configuration
    # -----------------------------
    input_path = "/Users/rohanbali/gis_work/run03/cities.gpkg"
    output_dir = "/Users/rohanbali/gis_work/run03/workspace"

    # Ensure output directory exists
    os.makedirs(output_dir, exist_ok=True)

    # Load the cities layer
    cities_layer = QgsVectorLayer(input_path, "Cities", "ogr")
    QgsProject.instance().addMapLayer(cities_layer)

    # ---------------------------------
    # 1. Attribute selection for A & B
    # ---------------------------------
    # Define selection parameters
    region_a_params = {
        'INPUT': input_path,
        'FIELD': 'REGION',
        'OPERATOR': 0,  # '='
        'VALUE': 'A',
        'METHOD': 0,
        'OUTPUT': unique_output_path(output_dir, "cities_A", ".gpkg")
    }
    region_b_params = {
        'INPUT': input_path,
        'FIELD': 'REGION',
        'OPERATOR': 0,  # '='
        'VALUE': 'B',
        'METHOD': 0,
        'OUTPUT': unique_output_path(output_dir, "cities_B", ".gpkg")
    }

    result_a = processing.run("qgis:selectbyattribute", region_a_params)
    result_b = processing.run("qgis:selectbyattribute", region_b_params)

    # Load resulting layers
    layer_a = QgsVectorLayer(result_a['OUTPUT'], "Cities_A", "ogr")
    layer_b = QgsVectorLayer(result_b['OUTPUT'], "Cities_B", "ogr")
    QgsProject.instance().addMapLayer(layer_a)
    QgsProject.instance().addMapLayer(layer_b)

    # ---------------------------------------
    # 2. Basic statistics for each subset
    # ---------------------------------------
    stats_fields = ['ERROR', 'GROWTH', 'NDVI', 'POP_DENS']

    def run_basic_stats(layer, subset_name):
        params = {
            'INPUT': layer,
            'FIELDS': stats_fields,
            'PERCENTILES': [0, 25, 50, 75, 100],
            'OUTPUT': 'TEMPORARY_OUTPUT'
        }
        result = processing.run("native:basicstatisticsforfields", params)
        report = result.get('REPORT', '')
        print(f"Basic statistics for {subset_name} (fields: {stats_fields}):")
        print(report)
        print("-" * 60)

    run_basic_stats(layer_a, "Region A")
    run_basic_stats(layer_b, "Region B")

    # ---------------------------------------------
    # 3. Linear regression across all cities
    # ---------------------------------------------
    import pandas as pd
    import statsmodels.api as sm

    df = pd.DataFrame(
        [feat.attributes() for feat in cities_layer.getFeatures()],
        columns=[field.name() for field in cities_layer.fields()]
    )

    X = df[['GROWTH', 'NDVI', 'POP_DENS']]
    X = sm.add_constant(X)  # adds intercept
    y = df['ERROR']

    model = sm.OLS(y, X).fit()
    print("Linear regression summary:")
    print(model.summary())

    pvalues = model.pvalues.drop('const')
    significant_vars = pvalues[pvalues < 0.05]
    if not significant_vars.empty:
        strongest_covariate = significant_vars.idxmin()
        print(f"Strongest statistically significant covariate: {strongest_covariate}")
    else:
        print("No covariate is statistically significant at 0.05 level.")

    # --------------------------------------------------
    # 4. Thematic point map of ERROR (regional differences)
    # --------------------------------------------------
    layer = cities_layer  # already added to project

    symbol = QgsSymbol.defaultSymbol(layer.geometryType())
    renderer = QgsGraduatedSymbolRenderer('', [])
    renderer.setClassAttribute('ERROR')
    renderer.setMode(QgsGraduatedSymbolRenderer.Quantile)  # Use quantile classification
    renderer.updateClasses(layer, 5)

    from PyQt5.QtGui import QColor
    color_start = QColor(30, 144, 255)  # DodgerBlue
    color_end = QColor(255, 69, 0)      # OrangeRed
    color_ramp = QgsGradientColorRamp(color_start, color_end)
    renderer.updateColorRamp(color_ramp)

    layer.setRenderer(renderer)
    layer.triggerRepaint()
    print("Thematic ERROR map applied to layer 'Cities'.")

# Execute the analysis function
perform_spatial_error_analysis()
