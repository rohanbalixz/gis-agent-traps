        'OUTPUT': str(median_out),
    }
    agg_res = processing.run("native:aggregate", params_agg)
    median_layer = QgsVectorLayer(agg_res['OUTPUT'], "Median Density", "ogr")
    QgsProject.instance().addMapLayer(median_layer)
