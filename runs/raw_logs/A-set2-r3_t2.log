import os
import processing
from qgis.core import (
    QgsVectorLayer,
    QgsProject,
    QgsGraduatedSymbolRenderer,
    QgsSymbol,
    QgsGradientColorRamp
)
from PyQt5.QtGui import QColor

def unique_path(base_path):
    """
    Return a unique file path by appending a numeric suffix if needed.
    """
    if not os.path.exists(base_path):
        return base_path
    name, ext = os.path.splitext(base_path)
    i = 1
    while True:
        new_path = f"{name}_{i}{ext}"
        if not os.path.exists(new_path):
            return new_path
        i += 1

def perform_population_density_analysis():
    # Input and output locations
    input_path = '/Users/rohanbali/gis_work/run15_t2/counties.gpkg'
    output_dir = '/Users/rohanbali/gis_work/run15_t2/workspace'

    # --------------------- 1. Add area field ---------------------
    area_field = 'Area_km2'
    add_area_params = {
        'INPUT': input_path,
        'FIELD_NAME': area_field,
        'FIELD_TYPE': 1,          # Decimal
        'FIELD_LENGTH': 10,
        'FIELD_PRECISION': 3,
        'OUTPUT': unique_path(os.path.join(output_dir, 'counties_with_area.gpkg'))
    }
    result = processing.run('native:addfieldtoattributestable', add_area_params)
    area_layer_path = result['OUTPUT']
    area_layer = QgsVectorLayer(area_layer_path, 'Counties_Area', 'ogr')
    QgsProject.instance().addMapLayer(area_layer)

    # --------------------- 2. Calculate area (km²) ---------------------
    area_calc_params = {
        'INPUT': area_layer_path,
        'EXPRESSION': f'($area/1000000)',
        'FIELD_NAME': area_field,
        'OUTPUT': unique_path(os.path.join(output_dir, 'counties_area_calculated.gpkg'))
    }
    result = processing.run('native:calculateexpression', area_calc_params)
    area_calc_path = result['OUTPUT']
    area_calc_layer = QgsVectorLayer(area_calc_path, 'Counties_Area_Calc', 'ogr')
    QgsProject.instance().addMapLayer(area_calc_layer)

    # --------------------- 3. Add density field ---------------------
    density_field = 'Density'
    add_density_params = {
        'INPUT': area_calc_path,
        'FIELD_NAME': density_field,
        'FIELD_TYPE': 1,          # Decimal
        'FIELD_LENGTH': 10,
        'FIELD_PRECISION': 3,
        'OUTPUT': unique_path(os.path.join(output_dir, 'counties_with_density.gpkg'))
    }
    result = processing.run('native:addfieldtoattributestable', add_density_params)
    density_layer_path = result['OUTPUT']
    density_layer = QgsVectorLayer(density_layer_path, 'Counties_Density', 'ogr')
    QgsProject.instance().addMapLayer(density_layer)

    # --------------------- 4. Calculate density ---------------------
    density_calc_params = {
        'INPUT': density_layer_path,
        'EXPRESSION': f'"POP2023" / "{area_field}"',
        'FIELD_NAME': density_field,
        'OUTPUT': unique_path(os.path.join(output_dir, 'counties_density_final.gpkg'))
    }
    result = processing.run('native:calculateexpression', density_calc_params)
    density_final_path = result['OUTPUT']
    density_final_layer = QgsVectorLayer(density_final_path, 'Counties_Density_Final', 'ogr')
    QgsProject.instance().addMapLayer(density_final_layer)

    # --------------------- 5. Median density ---------------------
    stats_params = {
        'INPUT': density_final_path,
        'FIELD': density_field
    }
    stats_result = processing.run('native:basicstatisticsforfields', stats_params)
    median_density = stats_result.get('median', None)
    print(f"Median population density (people/km²): {median_density}")

    # --------------------- 6. Count counties with density > 100 ---------------------
    expr_over_100 = f'"{density_field}" > 100'
    extract_params = {
        'INPUT': density_final_path,
        'EXPRESSION': expr_over_100,
        'OUTPUT': unique_path(os.path.join(output_dir, 'counties_over100.gpkg'))
    }
    result = processing.run('native:extractbyexpression', extract_params)
    over100_path = result['OUTPUT']
    over100_layer = QgsVectorLayer(over100_path, 'Counties_Over100', 'ogr')
    QgsProject.instance().addMapLayer(over100_layer)
    count_over_100 = over100_layer.featureCount()
    print(f"Number of counties with density > 100 people/km²: {count_over_100}")

    # --------------------- 7. Create thematic map ---------------------
    final_layer = QgsVectorLayer(density_final_path, 'Counties_Density_Final', 'ogr')
    QgsProject.instance().addMapLayer(final_layer)

    renderer = QgsGraduatedSymbolRenderer('', [])
    renderer.setClassAttribute(density_field)
    renderer.setMode(QgsGraduatedSymbolRenderer.Quantile)
    renderer.updateClasses(final_layer, 5)

    # Define a red colour ramp for density
    color_start = QColor(255, 228, 225)  # Light pink
    color_end   = QColor(139, 0, 0)      # Dark red
    ramp = QgsGradientColorRamp(color_start, color_end)
    renderer.updateColorRamp(ramp)

    final_layer.setRenderer(renderer)
    final_layer.triggerRepaint()
    print("Thematic map with graduated colour ramp created on 'Density' field.")

# Execute the function
perform_population_density_analysis()
