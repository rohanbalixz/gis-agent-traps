def unique_path(base_path):
    directory, filename = os.path.split(base_path)
    name, ext = os.path.splitext(filename)
    counter = 1
    unique = base_path
    while os.path.exists(unique):
        unique = os.path.join(directory, f"{name}_{counter}{ext}")
        counter += 1
    return unique

